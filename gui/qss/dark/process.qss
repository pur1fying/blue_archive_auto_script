#on_status {
    font-size:18px;
    padding:10px;
    font-weight:bold;
    color: white;
    background-color:#07bcb6;
    border-radius: 10px;
}

#listWidget {
    background-color: #7569e3;
    padding: 10px;
    border-radius: 10px;
}

#listWidget::item {
    background-color: transparent;
    color: inherit;
    border: none;
    outline: none;
}

#listWidget::item:hover {
    background-color: transparent;
    color: inherit;
    border: none;
    outline: none;
}

#listWidget::item:selected {
    background-color: transparent;
    color: inherit;
    border: none;
    outline: none;
}

#listWidget::item:selected:active {
    background-color: transparent;
    color: inherit;
    border: none;
    outline: none;
}
