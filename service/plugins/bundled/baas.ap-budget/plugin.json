{
  "schema_version": 1,
  "api_version": 1,
  "id": "baas.ap-budget",
  "version": "1.0.0",
  "name": {
    "en": "AP budget",
    "zh": "体力预算"
  },
  "description": {
    "en": "Estimate recovery and purchase counts. Assumes uncapped recovery and usable stored AP; supply purchase windows yourself. No purchases or device actions are performed.",
    "zh": "估算自然恢复与买管次数。按持续恢复、不触及上限且储存体力全部可用估算；购买窗口需自行填写。不自动买管或操作设备。"
  },
  "author": "BAAS contributors",
  "permissions": [
    "compute"
  ],
  "settings_schema": {
    "type": "object",
    "properties": {
      "recovery_per_hour": {
        "type": "number",
        "title": {
          "en": "AP recovery per hour",
          "zh": "每小时恢复体力"
        },
        "default": 10,
        "minimum": 0,
        "maximum": 60
      },
      "ap_per_purchase": {
        "type": "integer",
        "title": {
          "en": "AP per purchase",
          "zh": "每管获得体力"
        },
        "default": 120,
        "minimum": 1,
        "maximum": 999
      },
      "daily_purchase_limit": {
        "type": "integer",
        "title": {
          "en": "Maximum purchases per day",
          "zh": "每日最多买管数"
        },
        "default": 3,
        "minimum": 0,
        "maximum": 20
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "actions": [
    {
      "id": "calculate",
      "name": {
        "en": "Calculate AP budget",
        "zh": "计算体力预算"
      },
      "description": {
        "en": "Calculate a mathematical budget; expiry, recovery caps and the actual game state are not checked.",
        "zh": "仅计算数学预算，不校验邮件到期、体力上限或实际游戏状态。"
      },
      "execution": "compute",
      "entrypoint": "main:run",
      "input_schema": {
        "type": "object",
        "properties": {
          "current_ap": {
            "type": "integer",
            "title": {
              "en": "Current AP",
              "zh": "当前体力"
            },
            "default": 120,
            "minimum": 0,
            "maximum": 10000000
          },
          "stored_ap": {
            "type": "integer",
            "title": {
              "en": "Usable stored AP",
              "zh": "可领取的储存体力"
            },
            "default": 0,
            "minimum": 0,
            "maximum": 10000000,
            "description": {
              "en": "Exclude expired mail and resources unavailable before the target.",
              "zh": "请排除过期邮件及目标前无法领取的体力。"
            }
          },
          "target_ap": {
            "type": "integer",
            "title": {
              "en": "Target AP",
              "zh": "目标体力"
            },
            "default": 1000,
            "minimum": 0,
            "maximum": 10000000
          },
          "hours_remaining": {
            "type": "number",
            "title": {
              "en": "Hours until target",
              "zh": "距离目标的小时数"
            },
            "default": 24,
            "minimum": 0,
            "maximum": 744
          },
          "purchase_days": {
            "type": "integer",
            "title": {
              "en": "Available purchase windows",
              "zh": "可用购买窗口数"
            },
            "default": 1,
            "minimum": 1,
            "maximum": 31,
            "description": {
              "en": "Include today; each additional window represents another daily reset. This is independent of recovery hours.",
              "zh": "包含今天；每增加一个窗口表示经过一次每日重置，与恢复小时数独立。"
            }
          },
          "purchases_today": {
            "type": "integer",
            "title": {
              "en": "Purchases already made today",
              "zh": "今天已经买管数"
            },
            "default": 0,
            "minimum": 0,
            "maximum": 20
          }
        },
        "required": [
          "current_ap",
          "stored_ap",
          "target_ap",
          "hours_remaining",
          "purchase_days",
          "purchases_today"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "title": {
              "en": "Plan status",
              "zh": "计划状态"
            },
            "enum": [
              "covered",
              "planned",
              "shortfall"
            ]
          },
          "natural_recovery_ap": {
            "type": "integer",
            "minimum": 0,
            "title": {
              "en": "Estimated natural recovery",
              "zh": "预计自然恢复"
            }
          },
          "available_before_purchases": {
            "type": "integer",
            "minimum": 0,
            "title": {
              "en": "AP before purchases",
              "zh": "买管前可用体力"
            }
          },
          "required_purchases": {
            "type": "integer",
            "minimum": 0,
            "title": {
              "en": "Purchases needed",
              "zh": "达到目标所需买管数"
            }
          },
          "planned_purchases": {
            "type": "integer",
            "minimum": 0,
            "title": {
              "en": "Purchases within budget",
              "zh": "预算内买管数"
            }
          },
          "purchase_capacity": {
            "type": "integer",
            "minimum": 0,
            "title": {
              "en": "Available purchase count",
              "zh": "可用买管次数"
            }
          },
          "projected_ap": {
            "type": "integer",
            "minimum": 0,
            "title": {
              "en": "Estimated final AP",
              "zh": "预计最终体力"
            }
          },
          "remaining_shortfall": {
            "type": "integer",
            "minimum": 0,
            "title": {
              "en": "Remaining AP shortfall",
              "zh": "剩余体力缺口"
            }
          },
          "days": {
            "type": "array",
            "title": {
              "en": "Purchase windows",
              "zh": "购买窗口"
            },
            "maxItems": 31,
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "title": {
                    "en": "Window",
                    "zh": "窗口"
                  }
                },
                "purchases": {
                  "type": "integer",
                  "minimum": 0,
                  "title": {
                    "en": "Purchases",
                    "zh": "买管数"
                  }
                },
                "ap": {
                  "type": "integer",
                  "minimum": 0,
                  "title": {
                    "en": "Purchased AP",
                    "zh": "购买体力"
                  }
                }
              },
              "required": [
                "day",
                "purchases",
                "ap"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "status",
          "natural_recovery_ap",
          "available_before_purchases",
          "required_purchases",
          "planned_purchases",
          "purchase_capacity",
          "projected_ap",
          "remaining_shortfall",
          "days"
        ],
        "additionalProperties": false
      },
      "timeout_seconds": 5
    }
  ],
  "contributions": {
    "home": [
      {
        "id": "open",
        "title": {
          "en": "AP budget",
          "zh": "体力预算"
        },
        "description": {
          "en": "Estimate recovery and purchase counts. Assumes uncapped recovery and usable stored AP; supply purchase windows yourself. No purchases or device actions are performed.",
          "zh": "估算自然恢复与买管次数。按持续恢复、不触及上限且储存体力全部可用估算；购买窗口需自行填写。不自动买管或操作设备。"
        },
        "action_id": "calculate"
      }
    ]
  }
}
