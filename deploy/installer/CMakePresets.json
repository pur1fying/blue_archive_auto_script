{
  "version": 6,
  "configurePresets": [
    {
      "name": "installer-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}
    },
    {
      "name": "installer-release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "installer-debug", "configurePreset": "installer-debug"},
    {"name": "installer-release", "configurePreset": "installer-release"}
  ]
}
